# =======================================================================================
# .gitignore - Files to NEVER push to GitHub
# =======================================================================================

# CRITICAL: Secret Configuration Files
Secrets.js
Config.local.js

# Data exports / screenshots — may contain real customer PII (names, addresses, order IDs)
Screenshots/
*.xlsx
*.xls
*.csv

# Personal / internal documentation (not for public repo)
Learning/
CLAUDE.md
CONTRACTS.md
TESTING_SETUP.md
SECURITY_SETUP.md
VPS_INFRA.md
FEEDBACK_AUTOMATION_BUILD.md
EBAY_ANALYTICS_BUILD.md

# Claude Code per-user configuration
.claude/

# CLASP Configuration (contains Google Apps Script Project ID)
.clasp.json
.clasprc.json

# Google Apps Script Credentials
.clasprc.json
appsscript.json

# Node modules (if you add npm packages later)
node_modules/
package-lock.json

# Environment files
.env
.env.local
.env.production

# OS-specific files
.DS_Store
Thumbs.db
desktop.ini

# IDE-specific files
.vscode/
.idea/
*.swp
*.swo
*~

# Test files (optional - remove this line if you want to include tests)
test.js

# Logs
*.log
logs/

# Temporary files
*.tmp
*.temp

# Design lab — the TOOLING is tracked, the PAYLOAD is not.
#
# ⚠ Until 2026-08-31 this was a blanket `design-lab/`. That correctly kept ~84M of
#   node_modules and renders out of the repo — and took 6.1M of renderers and ~751
#   assertions across 23 suites with it. They lived on ONE machine with no backup, which
#   surfaced the day light.js's missing `mark`/`horiz` was fixed: a bug that had been live
#   for the entire life of the v2 and v3 face sets, corrected in a file git had never seen.
#
# ⚠ `design-lab/*`, NOT `design-lab/`. Git cannot re-include a file whose PARENT DIRECTORY
#   is excluded, so the blanket form would silently make every negation below a no-op.
design-lab/*
!design-lab/*.js
!design-lab/*.sh
!design-lab/*.html
# ⚠ A directory must be un-excluded before anything inside it can be re-included, which
#   is why this is `!design-lab/port/` and not `!design-lab/port/**`. 55K of one-off
#   tooling from the 2026-08-12 FloorBoard port — kept because CLAUDE.md cites port.py as
#   the worked example of the anchored-edit method (assert every anchor is unique, edit in
#   memory, write once at the end, so a failed assertion costs nothing).
!design-lab/port/

# ...but NOT the generated review artifacts. Each is its own *.template.html rendered with
# every screenshot base64-embedded — 12-32K of source becomes 1.4-2.0M of output. The
# template beside each one IS the source. Add any future one to this list.
design-lab/assessment-2026-08-11.html
design-lab/shipped.html
design-lab/redesign-round1.html
